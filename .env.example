# 选择网站回答问题时使用的模型服务。导入 DeepSeek 历史本身不需要任何 API 密钥。
# 可选值：siliconflow、deepseek、openai-compatible
AI_PROVIDER=deepseek

# 密钥只放在本机 .env.local 或部署平台的环境变量中，绝不能提交到 Git。
AI_API_KEY=

# SiliconFlow 示例：Qwen/Qwen2.5-7B-Instruct
# DeepSeek 示例：deepseek-chat
AI_MODEL=deepseek-chat

# 仅在使用其他 OpenAI-compatible 服务时填写。已知服务通常不需要修改。
AI_BASE_URL=

# 本机端口；开发环境固定只监听本机。
PORT=4175

# 仅在部署到反向代理后填写该代理的确切 IP/CIDR，多个值用逗号分隔。
# 留空时完全忽略 X-Forwarded-For；不要填写 0.0.0.0/0 或 ::/0。
TRUSTED_PROXY_NETWORKS=
